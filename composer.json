{
    "description": "Yii 2 Long Polling Example",
    "keywords": ["yii2", "longpoll", "longpoling", "comet", "server"],
    "type": "project",
    "license": "BSD-3-Clause",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "~2.0.52",
        "yiisoft/yii2-bootstrap": "~2.0.0",
        "izumi-kun/yii2-longpoll": "dev-php8.1"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.0.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "process-timeout": 1800,
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
